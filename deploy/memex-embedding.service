[Unit]
Description=Memex authenticated local embedding bridge
After=network.target ollama.service

[Service]
DynamicUser=yes
EnvironmentFile=/etc/memex-embedding.env
ExecStart=/usr/bin/python3 /opt/memex-embedding/embedding_proxy.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
