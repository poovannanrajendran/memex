# --- Gemini API ---
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_SYNTHESIS_MODEL=gemini-2.5-pro
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# --- Automation Engine ---
POSTGRES_URL=postgresql://dbuser:dbuser@192.168.1.30:5432/memex
YOUTUBE_DB_URL=postgresql://dbuser:dbuser@192.168.1.20:5432/youtube_liked_videos
POLL_INTERVAL_MINUTES=15

# --- Runner API ---
RUNNER_API_PORT=8000
RUNNER_API_SECRET=fad34ecf58ddccc88804a229715dfe6795d348fd513514bd54afa34c5bca91de

# --- OpenClaw Integration ---
# n8n webhook URL for incremental Qdrant sync
N8N_MEMEX_SYNC_URL=http://192.168.1.30:5678/webhook/memex-ingest
N8N_LINKEDIN_WEBHOOK_URL=http://192.168.1.30:5678/webhook/linkedin-post

# Qdrant configuration
QDRANT_HOST=http://192.168.1.20:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Notifications
OPENCLAW_NOTIFY_ENABLED=true

# Embedding-only authenticated bridge to existing local Ollama (no Gemini charges).
MEMEX_EMBED_URL=http://192.168.1.24:11435
MEMEX_EMBED_MODEL=nomic-embed-text:latest
MEMEX_EMBED_DIMENSIONS=768
MEMEX_EMBED_TOKEN=replace_with_private_bridge_token
MEMEX_QDRANT_COLLECTION=memex-knowledge-768d
